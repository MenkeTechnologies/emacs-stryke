;;; Commentary:

;; A major mode for stryke — a highly parallel Perl 5 superset interpreter
;; written in Rust.  Provides:
;;
;;   - filetype detection for `*.stk' files and stryke shebangs
;;   - syntax highlighting driven by the binary's own reflection tables: the
;;     COMPLETE builtin surface (all ~10,450 builtins) plus keywords, parallel
;;     primitives, types, sigil variables, strings, and operators
;;   - brace-aware indentation
;;   - language-server integration via `stryke --lsp' (eglot + lsp-mode)
;;
;; The 10,450-entry builtin set lives in `stryke-stdlib.el' as hash tables
;; (a single `regexp-opt' over that many names overflows Emacs' regexp
;; compiler), generated by scripts/gen-stdlib.sh.  Regenerate after a stryke
;; upgrade.

;;; Code:

(require 'stryke-stdlib)

;; Optional integrations — referenced only inside `with-eval-after-load' blocks,
;; declared here so the byte-compiler stays quiet when they are absent.
(defvar eglot-server-programs)
(defvar lsp-language-id-configuration)
(declare-function make-lsp-client "lsp-mode")
(declare-function lsp-register-client "lsp-mode")
(declare-function lsp-stdio-connection "lsp-mode")
(declare-function lsp-activate-on "lsp-mode")

(defgroup stryke nil
  "Major mode for the stryke language."
  :group 'languages
  :prefix "stryke-")

(defcustom stryke-executable "stryke"
  "Path to the stryke executable, used for the language server."
  :type 'string
  :group 'stryke)

(defcustom stryke-indent-offset 4
  "Number of spaces per indentation level in `stryke-mode'."
  :type 'integer
  :group 'stryke)

(defface stryke-parallel-face
  '((t :inherit font-lock-builtin-face :weight bold))
  "Face for stryke parallel primitives (pmap, pgrep, spawn, ...)."
  :group 'stryke)

;;; Keyword categories (the %k table, categorized as in the IntelliJ/vim/vscode
;;; ports).  These lists are small, so a plain `regexp-opt' is fine.

(defconst stryke--declarations
  '("my" "var" "val" "mysync" "varsync" "our" "oursync" "local" "state"
    "const" "frozen" "typed" "use" "no" "import" "package" "require"
    "pub" "priv")
  "stryke declaration keywords.")

(defconst stryke--fn-keywords
  '("fn" "sub" "class" "enum" "struct" "trait" "impl" "extends"
    "after" "around" "before")
  "stryke function / type introducers.")

(defconst stryke--control-keywords
  '("return" "if" "elsif" "else" "unless" "until" "while" "for" "foreach"
    "do" "last" "next" "redo" "loop" "continue" "goto" "given" "when"
    "default" "match" "try" "catch" "finally" "defer" "eval")
  "stryke control-flow keywords.")

(defconst stryke--concurrency-keywords
  '("async" "await" "spawn")
  "stryke concurrency keywords.")

(defconst stryke--phase-keywords
  '("BEGIN" "END" "INIT" "CHECK" "UNITCHECK")
  "stryke phase / block-hook keywords.")

(defconst stryke--word-operators
  '("and" "or" "not" "xor" "cmp" "eq" "ne" "lt" "le" "gt" "ge" "x")
  "stryke word operators.")

(defconst stryke--types
  '("Int" "Str" "Float" "Bool" "Num" "Any" "Array" "Hash" "List" "Map"
    "Set" "Void")
  "stryke optional type names.")

;;; Font-lock matcher functions for the large generated tables.

(defun stryke--fontify-table (table limit)
  "Search to LIMIT for the next identifier whose name is a key of TABLE.
On success leave point after the match, set the match data, and return t —
the function-matcher protocol font-lock expects."
  (let (found)
    (while (and (not found)
                (re-search-forward "\\_<\\(?:\\sw\\|\\s_\\)+\\_>" limit t))
      (when (gethash (match-string-no-properties 0) table)
        (setq found t)))
    found))

(defun stryke--fontify-builtin (limit)
  "Font-lock matcher for stryke builtins up to LIMIT."
  (stryke--fontify-table stryke-builtins-table limit))

(defun stryke--fontify-parallel (limit)
  "Font-lock matcher for stryke parallel primitives up to LIMIT."
  (stryke--fontify-table stryke-parallel-table limit))

(defconst stryke-font-lock-keywords
  `(;; Magic constants: __FILE__, __LINE__, ...
    ("\\_<__\\(?:FILE\\|LINE\\|PACKAGE\\|SUB\\|DATA\\|END\\)__\\_>"
     . font-lock-constant-face)
    ;; Keyword categories (small, safe regexp-opt).
    (,(regexp-opt stryke--declarations 'symbols) . font-lock-keyword-face)
    (,(regexp-opt stryke--fn-keywords 'symbols) . font-lock-keyword-face)
    (,(regexp-opt stryke--control-keywords 'symbols) . font-lock-keyword-face)
    (,(regexp-opt stryke--concurrency-keywords 'symbols) . font-lock-keyword-face)
    (,(regexp-opt stryke--phase-keywords 'symbols) . font-lock-preprocessor-face)
    (,(regexp-opt stryke--word-operators 'symbols) . font-lock-keyword-face)
    (,(regexp-opt stryke--types 'symbols) . font-lock-type-face)
    ("\\_<\\(?:true\\|false\\|undef\\|null\\)\\_>" . font-lock-constant-face)
    ;; The complete builtin surface (hash-table lookups; parallel first so it
    ;; wins its own face — the two sets are disjoint anyway).
    (stryke--fontify-parallel . 'stryke-parallel-face)
    (stryke--fontify-builtin . font-lock-builtin-face)
    ;; Sigil variables.
    ("\\$_\\>\\|@_\\>" . font-lock-constant-face)
    ("\\$#?\\$?[A-Za-z_][A-Za-z0-9_]*\\(?:::[A-Za-z0-9_]+\\)*"
     . font-lock-variable-name-face)
    ("[@%]\\$?[A-Za-z_][A-Za-z0-9_]*\\(?:::[A-Za-z0-9_]+\\)*"
     . font-lock-variable-name-face))
  "Font-lock keywords for `stryke-mode'.")

;;; Syntax table.

(defvar stryke-mode-syntax-table
  (let ((st (make-syntax-table)))
    (modify-syntax-entry ?# "<" st)     ; line comment start
    (modify-syntax-entry ?\n ">" st)    ; comment end
    (modify-syntax-entry ?_ "_" st)     ; symbol constituent
    (modify-syntax-entry ?\" "\"" st)   ; double-quoted string
    (modify-syntax-entry ?\' "\"" st)   ; single-quoted string
    (modify-syntax-entry ?\` "\"" st)   ; backtick string
    (modify-syntax-entry ?\\ "\\" st)   ; escape
    (modify-syntax-entry ?$ "." st)     ; sigils as punctuation
    (modify-syntax-entry ?@ "." st)
    (modify-syntax-entry ?% "." st)
    st)
  "Syntax table for `stryke-mode'.")

;;; Indentation — brace-aware, mirrors the vim-stryke / vscode-stryke rules.

(defun stryke-indent-line ()
  "Indent the current line for `stryke-mode'."
  (interactive)
  (let ((indent 0)
        (offset stryke-indent-offset))
    (save-excursion
      (beginning-of-line)
      (let ((closes-block (looking-at-p "[ \t]*[)}\\]]")))
        (when (zerop (forward-line -1))
          (while (and (looking-at-p "[ \t]*$") (zerop (forward-line -1))))
          (setq indent (current-indentation))
          ;; A line opening a block/paren/bracket (ignoring a trailing comment)
          ;; bumps the next line one level deeper.
          (when (looking-at-p ".*[[({][ \t]*\\(#.*\\)?$")
            (setq indent (+ indent offset))))
        (when closes-block
          (setq indent (max 0 (- indent offset))))))
    (if (<= (current-column) (current-indentation))
        (indent-line-to indent)
      (save-excursion (indent-line-to indent)))))

;;; LSP integration — eglot (built in since Emacs 29) and lsp-mode, both
;;; optional and configured lazily.

(with-eval-after-load 'eglot
  (add-to-list 'eglot-server-programs
               `(stryke-mode . (,stryke-executable "--lsp"))))

(with-eval-after-load 'lsp-mode
  (add-to-list 'lsp-language-id-configuration '(stryke-mode . "stryke"))
  (when (fboundp 'lsp-register-client)
    (lsp-register-client
     (make-lsp-client
      :new-connection (lsp-stdio-connection
                       (lambda () (list stryke-executable "--lsp")))
      :activation-fn (lsp-activate-on "stryke")
      :server-id 'stryke-lsp))))

;;;###autoload
(define-derived-mode stryke-mode prog-mode "Stryke"
  "Major mode for editing stryke source.

\\{stryke-mode-map}"
  :syntax-table stryke-mode-syntax-table
  (setq-local font-lock-defaults '(stryke-font-lock-keywords))
  (setq-local comment-start "# ")
  (setq-local comment-start-skip "#+[ \t]*")
  (setq-local comment-end "")
  (setq-local indent-line-function #'stryke-indent-line)
  (setq-local indent-tabs-mode nil)
  (setq-local tab-width stryke-indent-offset))

;;;###autoload
(add-to-list 'auto-mode-alist '("\\.stk\\'" . stryke-mode))

;;;###autoload
(add-to-list 'interpreter-mode-alist '("stryke" . stryke-mode))

(provide 'stryke-mode)
;;; stryke-mode.el ends here
