;;; gen-stdlib.el --- Generate stryke-stdlib.el -*- lexical-binding: t; -*-

;; Run from scripts/gen-stdlib.sh:
;;   emacs --batch -l scripts/gen-stdlib.el \
;;     --eval '(stryke-gen "plain.txt" "par.txt" "out.el" "VER" "NB")'
;;
;; All regexp computation and file writing happens inside Emacs, so no shell
;; escaping ever touches the (backslash-heavy) regexp strings.

;;; Code:

(require 'cl-lib)

(defun stryke-gen--words (file)
  "Return the non-empty lines of FILE as a list of strings."
  (split-string
   (with-temp-buffer (insert-file-contents file) (buffer-string))
   "\n" t "[ \t\r]+"))

(defun stryke-gen (plain-file par-file out-file ver nbuiltins)
  "Write OUT-FILE from PLAIN-FILE + PAR-FILE word lists.
VER and NBUILTINS are metadata strings for the header."
  (let* ((builtin-re (regexp-opt (stryke-gen--words plain-file) 'symbols))
         (par-re (regexp-opt (stryke-gen--words par-file) 'symbols)))
    (with-temp-file out-file
      (insert ";;; stryke-stdlib.el --- Generated stryke builtin tables -*- lexical-binding: t; -*-\n\n")
      (insert ";; GENERATED by scripts/gen-stdlib.sh from the stryke binary (%b / $c{parallel}).\n")
      (insert (format ";; stryke %s, %s builtins.  Do not edit by hand; rerun the generator.\n\n"
                      ver nbuiltins))
      (insert ";;; Code:\n\n")
      (insert (format "(defconst stryke-builtins-regexp %S\n  \"Symbol-bounded regexp matching every stryke builtin (generated).\")\n\n"
                      builtin-re))
      (insert (format "(defconst stryke-parallel-regexp %S\n  \"Symbol-bounded regexp matching stryke parallel primitives (generated).\")\n\n"
                      par-re))
      (insert "(provide 'stryke-stdlib)\n")
      (insert ";;; stryke-stdlib.el ends here\n"))))

(provide 'gen-stdlib)
;;; gen-stdlib.el ends here
